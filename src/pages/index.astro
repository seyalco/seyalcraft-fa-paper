---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const homePath = getRelativeLocaleUrl(locale, "");

const recentPosts = sortedPosts.slice(0, postsConfig.perIndex);
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="hero">
      <div class="hero-heading">
        <h1>سی‌نوشت</h1>

        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="rss-link"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="hero-description">
        یادداشت‌ها، ایده‌ها و چیزهایی که یاد می‌گیرم و می‌سازم.
      </p>

      {
        socials.length > 0 && (
          <div class="hero-socials">
            <Socials />
          </div>
        )
      }
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="posts-section">
          <h2>{t.home.recentPosts}</h2>

          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="all-posts">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding-block: 3rem 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    opacity: 0.75;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .rss-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .hero-description {
    max-width: 42rem;
    margin-block: 1rem 0;
    font-size: 1.05rem;
    line-height: 1.9;
    opacity: 0.8;
  }

  .hero-socials {
    margin-top: 1.25rem;
  }

  .posts-section {
    padding-block: 3rem 1rem;
  }

  .posts-section h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .posts-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .all-posts {
    margin-block: 2rem 3rem;
    text-align: center;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (
      document.querySelector("#main-content") as HTMLElement
    )?.dataset;

    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");

    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
