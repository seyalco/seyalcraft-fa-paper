---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const threads = (await getCollection("threads"))
  .sort((a, b) => a.data.id - b.data.id);

const renderedThreads = await Promise.all(
  threads.map(async (thread) => ({
    thread,
    Content: (await render(thread)).Content,
  }))
);

const batchSize = 5;
const visibleStart = Math.max(renderedThreads.length - batchSize, 0);
const hasOlderThreads = visibleStart > 0;
---

<Layout
  title="Threads — سی‌نوشت"
  description="یادداشت‌های کوتاه، ایده‌ها و چیزهایی که همین حالا در ذهنم هستند."
>
  <Header />

  <main id="main-content" class="threads-page">
    <section class="threads-header">
      <h1>Threads</h1>
      <p>
        یادداشت‌های کوتاه، ایده‌ها و چیزهایی که همین حالا در ذهنم هستند.
      </p>
    </section>

    <section class="threads-list" aria-label="Threads">
      {
        renderedThreads.map(({ thread, Content }, index) => (
          <>
            {index === visibleStart && hasOlderThreads && (
              <div class="older-threads">
                <button
                  id="load-older"
                  type="button"
                  aria-label="نمایش Threadهای قدیمی‌تر"
                >
                  <span class="older-arrow" aria-hidden="true">↑</span>
                  <span>Threadهای قدیمی‌تر</span>
                </button>
              </div>
            )}

            <article
              id={`thread-${thread.data.id}`}
              class:list={[
                "thread-card",
                index < visibleStart && "thread-hidden",
              ]}
              data-thread-index={index}
              data-thread-id={thread.data.id}
            >
              <header class="thread-meta">
                <a
                  class="thread-id"
                  href={`#thread-${thread.data.id}`}
                  aria-label={`Thread شماره ${thread.data.id}`}
                >
                  #{thread.data.id}
                </a>

                <time datetime={thread.data.createdAt.toISOString()}>
                  {thread.data.createdAt.toLocaleString("fa-IR", {
                    dateStyle: "medium",
                    timeStyle: "short",
                  })}
                </time>
              </header>

              <div class="thread-content">
                <div class="thread-body">
                  <Content />
                </div>

                <button
                  class="thread-expand"
                  type="button"
                  hidden
                  aria-expanded="false"
                >
                  <span class="thread-expand-label">نمایش بیشتر</span>
                  <span class="thread-expand-arrow" aria-hidden="true">↓</span>
                </button>
              </div>
            </article>
          </>
        ))
      }

      {
        renderedThreads.length === 0 && (
          <p class="threads-empty">
            هنوز Threadی منتشر نشده است.
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .threads-page {
    width: min(100%, 720px);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .threads-header {
    margin-bottom: 2rem;
  }

  .threads-header h1 {
    margin-bottom: 0.5rem;
  }

  .threads-header p {
    margin: 0;
    color: var(--text-color-light);
  }

  .threads-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .thread-card {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 0.9rem;
    background: var(--card-bg);
  }

  .thread-hidden {
    display: none;
  }

  .thread-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--text-color-light);
  }

  .thread-id {
    color: inherit;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .thread-id:hover {
    text-decoration: underline;
  }

  .thread-body {
    position: relative;
    max-height: 12rem;
    overflow: hidden;
  }

  .thread-body.is-collapsed::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 4rem;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--card-bg)
    );
  }

  .thread-content {
    position: relative;
  }

  .thread-expand {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.5rem auto 0;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .thread-expand:hover {
    opacity: 1;
  }

  .thread-expand-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  .thread-expand[aria-expanded="true"] .thread-expand-arrow {
    transform: rotate(180deg);
  }

  .thread-body.is-expanded {
    max-height: none;
  }

  .thread-body.is-expanded::after {
    display: none;
  }

  .older-threads {
    order: 0;
    display: flex;
    justify-content: center;
    margin-block: 0.25rem;
  }

  .older-threads button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }

  .older-threads button:hover {
    background: var(--card-bg);
  }

  .older-arrow {
    font-size: 1.1rem;
    line-height: 1;
  }

  .threads-empty {
    margin-block: 3rem;
    text-align: center;
    color: var(--text-color-light);
  }

  @media (max-width: 640px) {
    .threads-page {
      padding-inline: 0.75rem;
    }

    .thread-card {
      padding: 1rem;
    }
  }
</style>

<script>
  const batchSize = 5;

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".thread-card")
  );

  const loadOlderButton = document.querySelector<HTMLButtonElement>(
    "#load-older"
  );

  function updateExpandableCards() {
    cards.forEach((card) => {
      const body = card.querySelector<HTMLElement>(".thread-body");
      const button = card.querySelector<HTMLButtonElement>(".thread-expand");

      if (!body || !button) return;

      body.classList.remove("is-collapsed");
      button.hidden = true;

      if (body.scrollHeight > body.clientHeight + 4) {
        body.classList.add("is-collapsed");
        button.hidden = false;
      }
    });
  }

  function revealOlderThreads() {
    const hiddenCards = cards.filter((card) =>
      card.classList.contains("thread-hidden")
    );

    if (hiddenCards.length === 0) {
      loadOlderButton?.parentElement?.remove();
      return;
    }

    const previousHeight = document.documentElement.scrollHeight;

    hiddenCards
      .slice(-batchSize)
      .forEach((card) => card.classList.remove("thread-hidden"));

    const newHeight = document.documentElement.scrollHeight;

    window.scrollBy(0, newHeight - previousHeight);

    if (
      cards.every((card) => !card.classList.contains("thread-hidden"))
    ) {
      loadOlderButton?.parentElement?.remove();
    }

    updateExpandableCards();
  }

  loadOlderButton?.addEventListener("click", revealOlderThreads);

  cards.forEach((card) => {
    const body = card.querySelector<HTMLElement>(".thread-body");
    const button = card.querySelector<HTMLButtonElement>(".thread-expand");

    if (!body || !button) return;

    button.addEventListener("click", () => {
      const expanded = body.classList.toggle("is-expanded");

      if (expanded) {
        body.classList.remove("is-collapsed");
      } else {
        body.classList.add("is-collapsed");
      }

      button.setAttribute("aria-expanded", String(expanded));

      const label = button.querySelector(".thread-expand-label");

      if (label) {
        label.textContent = expanded ? "نمایش کمتر" : "نمایش بیشتر";
      }
    });
  });

  function revealUntilThread(threadId: string) {
    const target = document.getElementById(`thread-${threadId}`);

    if (!target) return false;

    while (target.classList.contains("thread-hidden")) {
      const hiddenCards = cards.filter((card) =>
        card.classList.contains("thread-hidden")
      );

      hiddenCards
        .slice(-batchSize)
        .forEach((card) => card.classList.remove("thread-hidden"));

      if (hiddenCards.length === 0) break;
    }

    return true;
  }

  function handleHash() {
    const threadId = window.location.hash.replace("#thread-", "");

    if (!threadId) return;

    if (revealUntilThread(threadId)) {
      requestAnimationFrame(() => {
        document
          .getElementById(`thread-${threadId}`)
          ?.scrollIntoView({ block: "center" });
      });
    }
  }

  updateExpandableCards();

  if (window.location.hash) {
    handleHash();
  } else if (cards.length > 0) {
    window.scrollTo({
      top: document.documentElement.scrollHeight,
      behavior: "instant",
    });
  }

  window.addEventListener("hashchange", handleHash);

  window.addEventListener("resize", updateExpandableCards);
</script>
