---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const threads = (await getCollection("threads"))
  .sort((a, b) => a.data.id - b.data.id);

const renderedThreads = await Promise.all(
  threads.map(async (thread) => ({
    thread,
    Content: (await render(thread)).Content,
  }))
);

const batchSize = 5;
const visibleStart = Math.max(renderedThreads.length - batchSize, 0);
const hasOlderThreads = visibleStart > 0;
---

<Layout
  title="Threads — سی‌نوشت"
  description="یادداشت‌های کوتاه، ایده‌ها و چیزهایی که همین حالا در ذهنم هستند."
>
  <Header />

  <main id="main-content" class="threads-page">
    <section class="threads-header">
      <h1>Threads</h1>
      <p>
        یادداشت‌های کوتاه، ایده‌ها و چیزهایی که همین حالا در ذهنم هستند.
      </p>
    </section>

    <section class="threads-viewport" aria-label="Threads">
      <div class="threads-list">
        {
          hasOlderThreads && (
            <div class="older-threads" id="older-threads">
              <button
                id="load-older"
                type="button"
                aria-label="نمایش Threadهای قدیمی‌تر"
              >
                <span class="older-arrow" aria-hidden="true">↑</span>
                <span>Threadهای قدیمی‌تر</span>
              </button>
            </div>
          )
        }

        {
          renderedThreads.map(({ thread, Content }, index) => (
            <article
              id={`thread-${thread.data.id}`}
              class:list={[
                "thread-card",
                index < visibleStart && "thread-hidden",
              ]}
              data-thread-index={index}
              data-thread-id={thread.data.id}
            >
              <header class="thread-meta">
                <a
                  class="thread-id"
                  href={`#thread-${thread.data.id}`}
                  aria-label={`Thread شماره ${thread.data.id}`}
                >
                  #{thread.data.id}
                </a>

                <time datetime={thread.data.createdAt.toISOString()}>
                  {thread.data.createdAt.toLocaleString("fa-IR", {
                    dateStyle: "medium",
                    timeStyle: "short",
                  })}
                </time>
              </header>

              <div class="thread-content">
                <div class="thread-body">
                  <Content />
                </div>

                <button
                  class="thread-expand"
                  type="button"
                  hidden
                  aria-expanded="false"
                >
                  <span class="thread-expand-label">نمایش بیشتر</span>
                  <span
                    class="thread-expand-arrow"
                    aria-hidden="true"
                  >
                    ↓
                  </span>
                </button>
              </div>
            </article>
          ))
        }

        {
          renderedThreads.length === 0 && (
            <p class="threads-empty">
              هنوز Threadی منتشر نشده است.
            </p>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .threads-page {
    width: min(100%, 720px);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .threads-header {
    margin-bottom: 2rem;
  }

  .threads-header h1 {
    margin-bottom: 0.5rem;
  }

  .threads-header p {
    margin: 0;
    color: var(--text-color-light);
  }

  /*
   * این viewport فعلاً فقط یک مرز منطقی برای feed است.
   * ارتفاع آن را بعداً، پس از تست رفتار، نهایی می‌کنیم.
   */
  .threads-viewport {
    position: relative;
    height: 70vh;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    scrollbar-width: none;
    overflow-anchor: none;
  }

  .threads-viewport::-webkit-scrollbar {
    display: none;
  }

  .threads-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .thread-card {
    position: relative;
    padding: 1.25rem;
    border: 1px solid var(--border-color);
    border-radius: 0.9rem;
    background: var(--card-bg);
  }

  .thread-hidden {
    display: none;
  }

  .thread-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--text-color-light);
  }

  .thread-id {
    color: inherit;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .thread-id:hover {
    text-decoration: underline;
  }

  .thread-body {
    position: relative;
    max-height: 12rem;
    overflow: hidden;
  }

  .thread-body.is-collapsed::after {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 4rem;
    content: "";
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--card-bg)
    );
  }

  .thread-content {
    position: relative;
  }

  .thread-expand {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.5rem auto 0;
    padding: 0.25rem 0.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  .thread-expand:hover {
    opacity: 1;
  }

  .thread-expand-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  .thread-expand[aria-expanded="true"] .thread-expand-arrow {
    transform: rotate(180deg);
  }

  .thread-body.is-expanded {
    max-height: none;
  }

  .thread-body.is-expanded::after {
    display: none;
  }

  .older-threads {
    display: flex;
    justify-content: center;
    margin-block: 0.25rem;
  }

  .older-threads button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
  }

  .older-threads button:hover {
    background: var(--card-bg);
  }

  .older-arrow {
    font-size: 1.1rem;
    line-height: 1;
  }

  .threads-empty {
    margin-block: 3rem;
    text-align: center;
    color: var(--text-color-light);
  }

  @media (max-width: 640px) {
    .threads-page {
      padding-inline: 0.75rem;
    }

    .thread-card {
      padding: 1rem;
    }
  }
</style>

<script>
  const batchSize = 5;

  let cleanupThreads: (() => void) | undefined;

  function initThreads() {
    cleanupThreads?.();

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".thread-card")
    );

    const loadOlderButton = document.querySelector<HTMLButtonElement>(
      "#load-older"
    );

    const olderThreads =
      document.querySelector<HTMLElement>("#older-threads");

    if (cards.length === 0) return;

    function updateExpandableCards() {
      cards.forEach((card) => {
        const body = card.querySelector<HTMLElement>(".thread-body");
        const button = card.querySelector<HTMLButtonElement>(
          ".thread-expand"
        );

        if (!body || !button) return;

        body.classList.remove("is-collapsed");
        button.hidden = true;

        if (body.scrollHeight > body.clientHeight + 4) {
          body.classList.add("is-collapsed");
          button.hidden = false;
        }
      });
    }

    function positionOlderThreadsButton() {
      if (!olderThreads) return;

      const oldestVisibleCard = cards.find(
        (card) => !card.classList.contains("thread-hidden")
      );

      if (oldestVisibleCard) {
        oldestVisibleCard.before(olderThreads);
      }
    }

    function revealOlderThreads() {
      const hiddenCards = cards.filter((card) =>
        card.classList.contains("thread-hidden")
      );

      if (hiddenCards.length === 0) {
        olderThreads?.remove();
        return;
      }

      const viewport =
        document.querySelector<HTMLElement>(".threads-viewport");

      if (!viewport) return;

      const previousScrollHeight = viewport.scrollHeight;
      const previousScrollTop = viewport.scrollTop;

      hiddenCards
        .slice(-batchSize)
        .forEach((card) => {
          card.classList.remove("thread-hidden");
        });

      positionOlderThreadsButton();

      const newScrollHeight = viewport.scrollHeight;

      viewport.scrollTop =
        previousScrollTop + (newScrollHeight - previousScrollHeight);

      if (
        cards.every(
          (card) => !card.classList.contains("thread-hidden")
        )
      ) {
        olderThreads?.remove();
      }

      updateExpandableCards();
    }

    function handleExpand(card: HTMLElement) {
      const body = card.querySelector<HTMLElement>(".thread-body");
      const button = card.querySelector<HTMLButtonElement>(
        ".thread-expand"
      );

      if (!body || !button) return;

      const expanded = body.classList.toggle("is-expanded");

      if (expanded) {
        body.classList.remove("is-collapsed");
      } else {
        body.classList.add("is-collapsed");
      }

      button.setAttribute("aria-expanded", String(expanded));

      const label = button.querySelector(".thread-expand-label");

      if (label) {
        label.textContent = expanded
          ? "نمایش کمتر"
          : "نمایش بیشتر";
      }
    }

    function revealUntilThread(threadId: string) {
      const target = document.getElementById(`thread-${threadId}`);

      if (!target) return false;

      while (target.classList.contains("thread-hidden")) {
        const hiddenCards = cards.filter((card) =>
          card.classList.contains("thread-hidden")
        );

        if (hiddenCards.length === 0) break;

        hiddenCards
          .slice(-batchSize)
          .forEach((card) => {
            card.classList.remove("thread-hidden");
          });
      }

      /*
       * بعد از اینکه Thread هدف ظاهر شد، دکمه باید
       * قبل از قدیمی‌ترین Thread قابل مشاهده قرار بگیرد.
       */
      const oldestVisibleCard = cards.find(
        (card) => !card.classList.contains("thread-hidden")
      );

      if (oldestVisibleCard && olderThreads) {
        oldestVisibleCard.before(olderThreads);
      }

      updateExpandableCards();

      return true;
    }

    function handleHash() {
      const threadId = window.location.hash.replace("#thread-", "");

      if (!threadId) return;

      const target = document.getElementById(`thread-${threadId}`);

      if (!target) return;

      if (revealUntilThread(threadId)) {
        requestAnimationFrame(() => {
          const viewport =
            document.querySelector<HTMLElement>(".threads-viewport");

          if (!viewport) return;

          /*
           * اگر هنوز Thread قدیمی‌تری وجود دارد،
           * ابتدای feed و دکمه «Threadهای قدیمی‌تر»
           * باید در بالاترین قسمت viewport دیده شوند.
           */
          if (olderThreads && document.contains(olderThreads)) {
            viewport.scrollTop = 0;
            return;
          }

          /*
           * اگر همه Threadها load شده‌اند، خود Thread هدف
           * را نمایش می‌دهیم.
           */
          target.scrollIntoView({
            block: "center",
          });
        });
      }
    }

    positionOlderThreadsButton();
    updateExpandableCards();

    if (window.location.hash) {
      handleHash();
    } else {
      const viewport =
        document.querySelector<HTMLElement>(".threads-viewport");

      if (viewport) {
        viewport.scrollTop = viewport.scrollHeight;
      }
    }

    loadOlderButton?.addEventListener(
      "click",
      revealOlderThreads
    );

    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>(
        ".thread-expand"
      );

      if (!button) return;

      button.addEventListener("click", () => {
        handleExpand(card);
      });
    });

    window.addEventListener("hashchange", handleHash);
    window.addEventListener("resize", updateExpandableCards);

    cleanupThreads = () => {
      loadOlderButton?.removeEventListener(
        "click",
        revealOlderThreads
      );

      cards.forEach((card) => {
        const button = card.querySelector<HTMLButtonElement>(
          ".thread-expand"
        );

        if (!button) return;

        button.replaceWith(button.cloneNode(true));
      });

      window.removeEventListener("hashchange", handleHash);
      window.removeEventListener("resize", updateExpandableCards);
    };
  }

  document.addEventListener("astro:page-load", initThreads);
</script>
